{
  "title": "Oriva voice pipeline",
  "uid": "oriva-pipeline",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "STT finalize latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, provider, model) (rate(oriva_stt_latency_seconds_bucket[5m])))", "legendFormat": "p50 {{provider}}/{{model}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, provider, model) (rate(oriva_stt_latency_seconds_bucket[5m])))", "legendFormat": "p95 {{provider}}/{{model}}" }
      ]
    },
    {
      "id": 2,
      "title": "LLM time-to-first-token (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, provider, model) (rate(oriva_llm_ttft_seconds_bucket[5m])))", "legendFormat": "p50 {{provider}}/{{model}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, provider, model) (rate(oriva_llm_ttft_seconds_bucket[5m])))", "legendFormat": "p95 {{provider}}/{{model}}" }
      ]
    },
    {
      "id": 3,
      "title": "TTS time-to-first-audio (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, provider, voice) (rate(oriva_tts_first_audio_seconds_bucket[5m])))", "legendFormat": "p50 {{provider}}/{{voice}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, provider, voice) (rate(oriva_tts_first_audio_seconds_bucket[5m])))", "legendFormat": "p95 {{provider}}/{{voice}}" }
      ]
    },
    {
      "id": 4,
      "title": "Voice-to-voice latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, llm_model) (rate(oriva_voice_to_voice_seconds_bucket[5m])))", "legendFormat": "p50 {{llm_model}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, llm_model) (rate(oriva_voice_to_voice_seconds_bucket[5m])))", "legendFormat": "p95 {{llm_model}}" }
      ]
    },
    {
      "id": 5,
      "title": "Bake-off: voice-to-voice p95 by combo",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "oriva_bakeoff_v2v_ms_p95", "legendFormat": "{{combo}}" }
      ]
    }
  ]
}
