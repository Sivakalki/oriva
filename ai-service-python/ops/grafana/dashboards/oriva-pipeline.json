{
  "title": "Oriva voice pipeline",
  "uid": "oriva-pipeline",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "STT finalize latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, provider, model) (rate(oriva_stt_latency_seconds_bucket[5m])))", "legendFormat": "p50 {{provider}}/{{model}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, provider, model) (rate(oriva_stt_latency_seconds_bucket[5m])))", "legendFormat": "p95 {{provider}}/{{model}}" }
      ]
    },
    {
      "id": 2,
      "title": "LLM time-to-first-token (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, provider, model) (rate(oriva_llm_ttft_seconds_bucket[5m])))", "legendFormat": "p50 {{provider}}/{{model}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, provider, model) (rate(oriva_llm_ttft_seconds_bucket[5m])))", "legendFormat": "p95 {{provider}}/{{model}}" }
      ]
    },
    {
      "id": 3,
      "title": "TTS time-to-first-audio (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, provider, voice) (rate(oriva_tts_first_audio_seconds_bucket[5m])))", "legendFormat": "p50 {{provider}}/{{voice}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, provider, voice) (rate(oriva_tts_first_audio_seconds_bucket[5m])))", "legendFormat": "p95 {{provider}}/{{voice}}" }
      ]
    },
    {
      "id": 4,
      "title": "Voice-to-voice latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, llm_model) (rate(oriva_voice_to_voice_seconds_bucket[5m])))", "legendFormat": "p50 {{llm_model}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, llm_model) (rate(oriva_voice_to_voice_seconds_bucket[5m])))", "legendFormat": "p95 {{llm_model}}" }
      ]
    },
    {
      "id": 5,
      "title": "Bake-off: voice-to-voice p95 by combo",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "oriva_bakeoff_v2v_ms_p95", "legendFormat": "{{combo}}" }
      ]
    },
    {
      "id": 6,
      "title": "Per-turn answer score (p50 / p95) — backend-go",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(oriva_turn_score_bucket[15m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(oriva_turn_score_bucket[15m])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 7,
      "title": "Overall interview score (p50 / p95) — backend-go",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(oriva_overall_score_bucket[15m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(oriva_overall_score_bucket[15m])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 8,
      "title": "Judge LLM latency by stage (p50 / p95) — backend-go",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le, stage) (rate(oriva_scoring_duration_seconds_bucket[15m])))", "legendFormat": "p50 {{stage}}" },
        { "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(oriva_scoring_duration_seconds_bucket[15m])))", "legendFormat": "p95 {{stage}}" }
      ]
    },
    {
      "id": 9,
      "title": "Scoring errors by stage — backend-go",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "sum by (stage) (rate(oriva_scoring_errors_total[15m]))", "legendFormat": "{{stage}}" }
      ]
    },
    {
      "id": 10,
      "title": "Interview context size, words (p50 / p95) — ai-service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(oriva_context_words_bucket[15m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(oriva_context_words_bucket[15m])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 11,
      "title": "Context compactions — ai-service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        { "expr": "rate(oriva_context_compressions_total[15m])", "legendFormat": "compactions/s" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(oriva_context_compress_seconds_bucket[15m])))", "legendFormat": "p95 duration (s)" }
      ]
    }
  ]
}
